# Keystatic storage: leave unset for local mode (edits files on disk).
# Set to "github" in production so edits become commits (Phase 5).
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github

# Required only in GitHub mode (set as Cloudflare Worker secrets, never commit them):
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
